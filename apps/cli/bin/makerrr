#!/usr/bin/env node

// Makerrr command alias for the Cline-derived platform binary resolver.
// The platform package remains @cline/cli-* for workspace compatibility.

if (process.env.MAKERRR_BIN_PATH && !process.env.CLINE_BIN_PATH) {
	process.env.CLINE_BIN_PATH = process.env.MAKERRR_BIN_PATH;
}

require("./cline");
